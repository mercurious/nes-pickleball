+//records what the sound mixer outputs to a WAV file (the same path as the UI's Sound Recorder)
+int LuaApi::StartWaveRecording(lua_State* lua)
+{
+	LuaCallHelper l(lua);
+	string path = l.ReadString();
+	checkparams();
+	_emu->GetSoundMixer()->StartRecording(path);
+	return l.ReturnCount();
+}
+
+int LuaApi::StopWaveRecording(lua_State* lua)
+{
+	LuaCallHelper l(lua);
+	checkparams();
+	_emu->GetSoundMixer()->StopRecording();
+	return l.ReturnCount();
+}
