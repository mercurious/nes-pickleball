# NES Pickleball's score for Pently (lib/pently/pentlyas.md describes the language). Built by the Makefile into
# build/music.s. The jingles and the title tune are v0.0.1's, note for note, as placeholders until the new music:
# the same pitches, the frame lengths rounded to 3-frame rows, a softer attack and decay instead of a flat square,
# and a little quieter. The court's synthesized sounds are below them; the sampled ones are the DMC's (src/sound.c).

title NES Pickleball

# Instruments ---------------------------------------------------------------------------------------------------

instrument lead
  timbre 2
  volume 9 8 7 7 6
  decay 1
  detached

instrument bass
  timbre 2
  volume 8

# The jingles (3 frames a row: time 4/4, scale 32, tempo 150) ----------------------------------------------------

song fault
  time 4/4
  scale 32
  tempo 150
  pattern fault_p
    absolute
    e16 c#16 r32 b,16. r4
  pattern fault_t
    absolute
    r8 b,16. r32 r4
  at 1
  play fault_p on pulse2 with lead
  play fault_t on triangle with bass
  at 1:3
  fine

song point
  time 4/4
  scale 32
  tempo 150
  pattern point_p
    absolute
    c'32 e'32 g'32 c''16. r16 r4
  pattern point_t
    absolute
    c8 c'16. r32 r4
  at 1
  play point_p on pulse2 with lead
  play point_t on triangle with bass
  at 1:3
  fine

song sideout
  time 4/4
  scale 32
  tempo 150
  pattern sideout_p
    absolute
    g'16 e'16 c'16. r32 r4
  pattern sideout_t
    absolute
    g16. c16. r16 r4
  at 1
  play sideout_p on pulse2 with lead
  play sideout_t on triangle with bass
  at 1:3
  fine

song game
  time 4/4
  scale 32
  tempo 150
  pattern game_p
    absolute
    c'16 c'16 c'16 e'8 g'16 e'16 g'16 c''8.. r32 r8
  pattern game_t
    absolute
    c8 c16 e8 g16 c8 g16 c'8.. r8
  at 1
  play game_p on pulse2 with lead
  play game_t on triangle with bass
  at 2:1
  fine

song title_tune
  time 4/4
  scale 32
  tempo 150
  pattern title_p
    absolute
    c'8 c'8 e'8 e'8 g'8 e'8 c'4 d'8 d'8 f'8 f'8 g'8 f'8 d'4
    c'8 e'8 g'8 c''8 b'8 g'8 e'4 a'8 g'8 f'8 e'8 d'8 e'8 c'4
  pattern title_t
    absolute
    c4 g4 c4 g4 d4 a4 d4 a4 c4 g4 c4 g4 f4 g4 c2
  at 1
  play title_p on pulse2 with lead
  play title_t on triangle with bass
  at 5
  dal segno

# Interface sounds --------------------------------------------------------------------------------------------------

sfx menu on pulse
  timbre 2
  volume 7 7 5 5 3 2 1
  pitch a' a' d'' d'' d'' d'' d''

sfx pause on pulse
  timbre 2
  volume 8 8 8 8 7 7 7 7 5 3 1
  pitch f#' f#' f#' f#' b' b' b' b' b' b' b'

# The court, synthesized ------------------------------------------------------------------------------------------
# A real pock is a click with a hollow ring near 1.3 kHz that dies 20 dB within 20-25 ms (the CC0 recordings,
# tools/findpocks.py). Frames are 17 ms, so the synthesized ring is two frames: a 25 % pulse for the attack, then
# 50 % at a third of the volume. Under the sampled pock it gives the hit its body; alone it is the synth version.
# (NES Tennis sweeps a 50 % pulse down from about 1 kHz and fades it over 0.4 s: a tennis "ponk", too long here.)

sfx ponk on pulse
  volume 13 5 1
  timbre 1 2
  pitch e''' d#''' d'''

sfx ponk_soft on pulse
  volume 8 3 1
  timbre 2
  pitch c''' b'' a#''

# the crack under a drive or a smash: one frame of metallic noise
sfx crack on noise
  volume 9 3
  timbre 1 0
  pitch 12 10

# the bounce on a hard court: a short low knock (the triangle has no volume, so the length is the envelope)
sfx knock on triangle
  volume 15 15 0
  pitch c''' g''

sfx tick on noise
  volume 4 1
  pitch 10 8

# the net cord: a dull thud, the cord rattling
sfx cord on noise
  volume 9 7 5 4 3 2 1
  pitch 4 3 5 3 4 3 2

sfx cord_tri on triangle
  volume 15 15 15 15 0
  pitch c'' a' f' d'

include crowd.pently
